{
  "name": "autoform",
  "version": "1.0.0",
  "description": "Autonomous event registration engine for TOKEN2049 & KBW events with stealth browser automation, Radix combobox solver, and anti-bot pacing",
  "type": "module",
  "scripts": {
    "start": "tsx src/index.ts",
    "run:devishree": "tsx src/index.ts --person devishree-mohan",
    "run:kamesh": "tsx src/index.ts --person kameshwaran-elangovan",
    "run:ram": "tsx src/index.ts --person ramkumar-subramanian",
    "run:reset": "tsx src/index.ts --person devishree-mohan --reset",
    "run:all": "tsx src/index.ts --all-team",
    "run:red": "tsx src/index.ts --red-events",
    "run:red:all": "tsx src/index.ts --red-events --all-team",
    "retry:red": "tsx src/index.ts --red-events --all-team --retry-failed",
    "run:token2049": "tsx src/index.ts --token2049 --person devishree-mohan",
    "run:token2049:all": "tsx src/index.ts --token2049 --all-team",
    "run:successful": "tsx src/index.ts --successful --person devishree-mohan",
    "run:successful:all": "tsx src/index.ts --successful --all-team",
    "retry:token2049": "tsx src/index.ts --token2049 --all-team --retry-failed",
    "db:summary": "tsx src/db-cli.ts summary",
    "db:submitted": "tsx src/db-cli.ts submitted",
    "db:failed": "tsx src/db-cli.ts not-submitted",
    "db:fields": "tsx src/db-cli.ts fields",
    "db:export": "tsx src/db-cli.ts export",
    "build": "tsc"
  },
  "dependencies": {
    "playwright": "^1.49.0"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0"
  }
}